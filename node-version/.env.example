# LLM API key (required)
# Example (OpenAI): https://platform.openai.com/api-keys
LLM_API_KEY=your_llm_api_key_here

# Optional: provider and model configuration
# Current providers: openai (can target OpenAI-compatible endpoints via LLM_BASE_URL)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1

# Backward compatibility aliases (optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

LOG_PROMPTS=true
AUTO_FIX_AFTER_EDITS=true